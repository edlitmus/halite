[Unit]
Description=halite hub
Documentation=https://github.com/edlitmus/halite
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/halite-hub serve --config /etc/halite/hub.yaml
# No ExecReload. Nothing here handles SIGHUP, so Go's default disposition
# applies and the signal terminates the process: `systemctl reload`
# stopped the service and dropped every connected node's stream. Without
# the directive systemd reports that reload is unsupported instead.
# Changing configuration is a restart.
Restart=on-failure
RestartSec=5s

# The hub serves files, compiles pillar, and holds the enrollment CA. It
# changes nothing about the host it runs on, so unlike the node it can
# take the full sandbox.
User=halite
Group=halite
DynamicUser=no
# /var/lib/halite, /var/cache/halite and /var/log/halite, which are what
# the hub uses by default on Linux, so hub.yaml needs to name none of
# them. No RuntimeDirectory: `socket_dir` is read by nothing today, so it
# would create a directory that stays empty.
StateDirectory=halite
StateDirectoryMode=0700
# `cache_dir`. `serve` creates <cache dir>/nodes and probe-writes it
# before it will start, so without this the unit described a hub that
# exited at startup: ProtectSystem=strict leaves /var/cache read-only
# even when `make install` has already created the directory. 0700, as
# `make install` and OpenNodeCache both make it. Systemd may empty a
# cache directory (`systemctl clean --what=cache`); the hub rebuilds the
# node data as nodes reconnect, and gitfs and s3fs fetch again.
CacheDirectory=halite
CacheDirectoryMode=0700
LogsDirectory=halite
ProtectSystem=strict
# The enrollment CA and the hub's serving certificate live in the
# configuration root, which ProtectSystem=strict makes read-only. `serve`
# creates them on first run, so that one directory is writable and
# nothing else under /etc is.
ReadWritePaths=/etc/halite/pki
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

TasksMax=8192
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=halite-hub

[Install]
WantedBy=multi-user.target
