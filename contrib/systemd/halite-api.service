[Unit]
Description=halite HTTP API
Documentation=https://github.com/edlitmus/halite
After=network-online.target halite-hub.service
Wants=network-online.target

[Service]
Type=simple
# `serve` runs the HTTP API: login and tokens, the execution endpoints,
# the event stream, webhook ingress, and the Prometheus exposition. It is
# a client of the hub holding its own operator certificate.
ExecStart=/usr/local/bin/halite-api serve --config /etc/halite/api.yaml
# No ExecReload. Nothing here handles SIGHUP, so Go's default disposition
# applies and the signal terminates the process: `systemctl reload`
# stopped the service and dropped every connected node's stream. Without
# the directive systemd reports that reload is unsupported instead.
# Changing configuration is a restart.
Restart=on-failure
RestartSec=5s
# `serve` exits 1 for the things a restart cannot fix: no operator
# certificate, no serving certificate, a hooks block that will not parse.
# Restarting on those is a loop that fills the journal and tells the
# operator nothing, so exit 1 stops the unit and leaves the message where
# it can be read.
RestartPreventExitStatus=1

# The API talks to the hub and to HTTP clients and touches nothing else,
# so it takes the same sandbox as the hub.
User=halite
Group=halite
# /var/lib/halite-api, which api.yaml has to name as `state_dir` — the
# token store goes there. ProtectSystem=strict makes everything else
# read-only, so a service using the built-in default of /var/lib/halite
# could not write its tokens at all. contrib/examples/api.yaml sets it.
StateDirectory=halite-api
StateDirectoryMode=0700
LogsDirectory=halite
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=halite-api

[Install]
WantedBy=multi-user.target
