[Unit]
Description=halite HTTP API
Documentation=https://github.com/edlitmus/halite
After=network-online.target halite-hub.service
Wants=network-online.target

[Service]
Type=simple
# `serve` arrives in phase 4 of SPEC section 32.
ExecStart=/usr/local/bin/halite-api serve --config /etc/halite/api.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
# `serve` exits 1 while its phase has not landed. Restarting on that would
# be a loop that fills the journal and tells the operator nothing, so exit
# 1 stops the unit and leaves the message in the log where it can be read.
# Once the phase lands, a genuine failure exits with something else.
RestartPreventExitStatus=1

# The API talks to the hub and to HTTP clients and touches nothing else,
# so it takes the same sandbox as the hub.
User=halite
Group=halite
StateDirectory=halite-api
StateDirectoryMode=0700
LogsDirectory=halite
RuntimeDirectory=halite-api
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=halite-api

[Install]
WantedBy=multi-user.target
