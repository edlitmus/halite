[Unit]
Description=halite HTTP API
Documentation=https://github.com/edlitmus/halite
After=network-online.target halite-hub.service
Wants=network-online.target

[Service]
Type=simple
# `serve` runs the HTTP API: login and tokens, the execution endpoints,
# the event stream, webhook ingress, and the Prometheus exposition. It is
# a client of the hub holding its own operator certificate.
ExecStart=/usr/local/bin/halite-api serve --config /etc/halite/api.yaml
# No ExecReload. Nothing here handles SIGHUP, so Go's default disposition
# applies and the signal terminates the process: `systemctl reload`
# stopped the service and dropped every connected node's stream. Without
# the directive systemd reports that reload is unsupported instead.
# Changing configuration is a restart.
Restart=on-failure
RestartSec=5s
# `serve` exits 78 (sysexits' EX_CONFIG) for the things a restart cannot
# fix: no operator certificate, no serving certificate, a hooks block or
# a role map that will not parse, a token store it may not write.
# Restarting on those is a loop that fills the journal and tells the
# operator nothing, so 78 stops the unit and leaves the message where it
# can be read.
#
# Not 1, which this unit used to name: `serve` exits 1 for a listen
# address that is not on the host yet, a port still held, and a failure
# while it is serving, and a restart is the fix for those. With =1 an API
# whose address came up late at boot stayed down. DIVERGENCE 5.289.
RestartPreventExitStatus=78

# The API talks to the hub and to HTTP clients and touches nothing else,
# so it takes the same sandbox as the hub.
User=halite
Group=halite
# The token store, <state_dir>/tokens, and the only thing the API writes
# under its state directory. On the built-in default that is
# /var/lib/halite/tokens: inside the hub's state directory, as SPEC 27.3
# lays it out, and the one part of it this service may write --
# ProtectSystem=strict leaves the hub's job cache, events and evidence
# read-only to it. This used to be StateDirectory=halite-api alone, which
# made a service on the built-in default unable to write a token and so
# exit at startup; api.yaml had to move state_dir to make the unit work.
#
# halite-api stays for the installs that did that, by following the old
# example: /var/lib/halite-api is still made writable, so their
# `state_dir: /var/lib/halite-api` keeps working.
#
# systemd creates the innermost directory owned by the unit's account at
# this mode; a /var/lib/halite it has to create as well is root's, 0755,
# and the hub's unit or `make install` gives it to halite.
StateDirectory=halite/tokens halite-api
StateDirectoryMode=0700
LogsDirectory=halite
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

StandardOutput=journal
StandardError=journal
SyslogIdentifier=halite-api

[Install]
WantedBy=multi-user.target
