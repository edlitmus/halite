#!/bin/sh
#
# PROVIDE: halite_agent
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# Add these to /etc/rc.conf with sysrc(8):
#
#   sysrc halite_agent_enable="YES"
#
# The control plane to talk to belongs in the config file, but it is the
# one setting a host often gets from an image or a provisioning script, so
# it can be given here too:
#
#   halite_agent_enable      run the agent at boot (default NO)
#   halite_agent_config      settings file
#                            (default /usr/local/etc/halite/agent.conf)
#   halite_agent_master      control plane host[:port], or several
#                            comma-separated for failover. Overrides the
#                            config file's `master`
#   halite_agent_binary     the halite binary (default /usr/local/bin/halite)
#   halite_agent_flags       extra flags, appended after -config
#   halite_agent_pidfile     (default /var/run/halite/halite_agent.pid)
#   halite_agent_daemon_args flags for daemon(8) itself; add -r to have it
#                            restart the agent if it exits
#
# The agent applies states, so it runs as root. Output goes to syslog
# under the daemon facility.

# Note the name: rc.subr reserves ${name}_program and uses it to replace
# $command, which here is daemon(8). Calling this halite_agent_program
# made rc.subr run halite with daemon's arguments — "unknown command -S".
#
. /etc/rc.subr

name="halite_agent"
rcvar="halite_agent_enable"

load_rc_config $name

: ${halite_agent_enable:="NO"}
: ${halite_agent_config:="/usr/local/etc/halite/agent.conf"}
: ${halite_agent_binary:="/usr/local/bin/halite"}
: ${halite_agent_master:=""}
: ${halite_agent_flags:=""}
: ${halite_agent_pidfile:="/var/run/halite/${name}.pid"}
: ${halite_agent_daemon_args:=""}

halite_agent_master_flag=""
if [ -n "${halite_agent_master}" ]; then
	halite_agent_master_flag="-master ${halite_agent_master}"
fi

# rc.subr builds "$command $rc_flags $command_args", and $command here is
# daemon(8) — so anything left in halite_agent_flags would be passed to
# daemon rather than to halite. Take the operator's flags, put them where
# they belong (after the subcommand, below), and leave rc.subr nothing to
# splice in.
halite_agent_extra_flags="${halite_agent_flags}"
halite_agent_flags=""

pidfile="${halite_agent_pidfile}"
procname="${halite_agent_binary}"
command="/usr/sbin/daemon"
command_args="-S -T ${name} -p ${pidfile} ${halite_agent_daemon_args} \
    ${halite_agent_binary} agent -config ${halite_agent_config} \
    ${halite_agent_master_flag} ${halite_agent_extra_flags}"

start_precmd="halite_agent_precmd"

halite_agent_precmd()
{
	# An agent with neither a config file nor halite_agent_master has no
	# control plane to reach, and would fail a second later with a less
	# useful message.
	if [ -n "${halite_agent_config}" ] && [ ! -r "${halite_agent_config}" ] &&
	    [ -z "${halite_agent_master}" ]; then
		err 1 "no ${halite_agent_config} and no halite_agent_master: the agent has no control plane to reach"
	fi
	# install(1) applies its mode whether or not it had to create the path,
	# so running it on an existing shared directory like /var/run silently
	# resets that directory's permissions. Create only what is missing.
	halite_agent_rundir=$(dirname "${pidfile}")
	if [ ! -d "${halite_agent_rundir}" ]; then
		install -d -m 0755 "${halite_agent_rundir}"
	fi
}

run_rc_command "$1"
