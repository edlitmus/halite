#!/bin/sh
#
# PROVIDE: halite_master
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown
#
# Add these to /etc/rc.conf with sysrc(8):
#
#   sysrc halite_master_enable="YES"
#
# Everything else has a default, and the settings a fleet actually varies
# belong in the config file rather than here:
#
#   halite_master_enable      run the control plane at boot (default NO)
#   halite_master_config      settings file
#                             (default /usr/local/etc/halite/master.conf)
#   halite_master_binary     the halite binary
#                             (default /usr/local/bin/halite)
#   halite_master_flags       extra flags, appended after -config
#   halite_master_user        account to run as (default root)
#   halite_master_pidfile     (default /var/run/halite/halite_master.pid;
#                             the directory is created for halite_master_user,
#                             and an existing one is never modified)
#   halite_master_daemon_args flags for daemon(8) itself; add -r to have it
#                             restart the control plane if it exits
#
# The control plane needs to read the PKI directory, the state tree, and
# the pillar tree, and to bind its port — none of which requires root, so
# halite_master_user is worth setting to an account that owns exactly
# those. Output goes to syslog under the daemon facility.

# Note the name: rc.subr reserves ${name}_program and uses it to replace
# $command, which here is daemon(8). Calling this halite_master_program
# made rc.subr run halite with daemon's arguments — "unknown command -S".
#
. /etc/rc.subr

name="halite_master"
rcvar="halite_master_enable"

load_rc_config $name

: ${halite_master_enable:="NO"}
: ${halite_master_config:="/usr/local/etc/halite/master.conf"}
: ${halite_master_binary:="/usr/local/bin/halite"}
: ${halite_master_flags:=""}
: ${halite_master_user:="root"}
: ${halite_master_pidfile:="/var/run/halite/${name}.pid"}
: ${halite_master_daemon_args:=""}

# rc.subr builds "$command $rc_flags $command_args", and $command here is
# daemon(8) — so anything left in halite_master_flags would be passed to
# daemon rather than to halite. Take the operator's flags, put them where
# they belong (after the subcommand, below), and leave rc.subr nothing to
# splice in.
halite_master_extra_flags="${halite_master_flags}"
halite_master_flags=""

pidfile="${halite_master_pidfile}"
procname="${halite_master_binary}"
command="/usr/sbin/daemon"
command_args="-S -T ${name} -p ${pidfile} ${halite_master_daemon_args} \
    ${halite_master_binary} master -config ${halite_master_config} ${halite_master_extra_flags}"

start_precmd="halite_master_precmd"

halite_master_precmd()
{
	# rc.subr already refuses to run a program that is not there. What it
	# cannot know is that the config file is optional: a fleet can run
	# entirely on flags, so a missing one is a warning rather than a stop.
	if [ -n "${halite_master_config}" ] && [ ! -r "${halite_master_config}" ]; then
		warn "${halite_master_config} is not readable; starting on flags alone"
	fi

	# install(1) applies -o and -m whether or not it had to create the
	# path, so running it on a directory that already exists rewrites that
	# directory. On a shared one like /var/run that hands the service
	# account every pid file and socket in it — which is a way back to
	# root. Create only a directory that is not there, and only ever this
	# service's own.
	halite_master_rundir=$(dirname "${pidfile}")
	if [ ! -d "${halite_master_rundir}" ]; then
		install -d -o "${halite_master_user}" -m 0755 "${halite_master_rundir}"
	elif halite_master_rundir_owner=$(stat -f %Su "${halite_master_rundir}" 2>/dev/null) &&
	    [ "${halite_master_rundir_owner}" != "${halite_master_user}" ]; then
		# Pointed at a directory somebody else owns — usually /var/run
		# itself. Say so rather than fix it: taking ownership is the bug
		# this guard exists to prevent.
		warn "${halite_master_rundir} is owned by ${halite_master_rundir_owner}, not ${halite_master_user}; the pid file may not be written"
	fi
}

run_rc_command "$1"
