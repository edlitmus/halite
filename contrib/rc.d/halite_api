#!/bin/sh

# PROVIDE: halite_api
# REQUIRE: LOGIN FILESYSTEMS halite_hub
# KEYWORD: shutdown
#
# halite-api, the HTTP API service.
#
#   halite_api_enable (bool):  Set to "NO" by default.
#   halite_api_config (str):   Configuration file.
#                              Default /usr/local/etc/halite/api.yaml
#   halite_api_flags (str):    Extra arguments to `halite-api serve`.
#   halite_api_user (str):     Account to run as. Default halite.
#
# `serve` runs the HTTP API: login and tokens, the execution endpoints,
# the event stream, webhook ingress, and the Prometheus exposition. It is
# a client of the hub holding its own operator certificate.

. /etc/rc.subr

name=halite_api
rcvar=halite_api_enable
desc="halite HTTP API"

load_rc_config $name

: ${halite_api_enable="NO"}
: ${halite_api_config="/usr/local/etc/halite/api.yaml"}
: ${halite_api_flags=""}
: ${halite_api_user="halite"}
# The FIPS deployment of SPEC 27.4. Setting halite_api_fips="YES" in
# rc.conf runs the -fips artifact with FIPS mode stated rather than
# inherited, so a GODEBUG in the environment cannot quietly turn it off.
#
# Named _binary and not _program: rc.subr reserves `${name}_program` and
# uses it to replace `command`, so calling it that silently bypassed
# daemon(8) and ran the binary with daemon's own flags as arguments.
: ${halite_api_fips="NO"}
if checkyesno halite_api_fips; then
	: ${halite_api_binary="/usr/local/bin/halite-api-fips"}
	: ${halite_api_env="GODEBUG=fips140=on"}
else
	: ${halite_api_binary="/usr/local/bin/halite-api"}
	: ${halite_api_env=""}
fi

pidfile="/var/run/halite/${name}.pid"
# The pid in that file is the program's, not daemon(8)'s: `-p` records the
# child. rc.subr matches the pidfile's process against `procname`, which
# defaults to `command` — so without this it looked for `daemon` at a pid
# belonging to halite-api , found nothing, and reported the
# service as not running. `stop` and `restart` then did nothing at all.
procname="${halite_api_binary}"
logfile="/var/log/halite/api.log"

command="/usr/sbin/daemon"
command_args="-c -f -p ${pidfile} -o ${logfile} \
	${halite_api_env:+env ${halite_api_env}} ${halite_api_binary} serve --config ${halite_api_config} ${halite_api_flags}"

required_files="${halite_api_config}"
start_precmd="halite_api_prestart"

halite_api_prestart()
{
	# Create the log directory if it is missing. An existing one is left
	# exactly as it is: a site that has given it to another account, or
	# pointed it at a separate filesystem, meant to, and refusing to start
	# over that would be this script second-guessing the operator.
	if [ ! -d /var/log/halite ]; then
		install -d -o "${halite_api_user}" -m 0750 /var/log/halite || return 1
	fi
	# And a directory for the pidfile that the account can write. This
	# runs as root; by the time daemon(8) runs, rc.subr has already
	# dropped to halite_api_user, so /var/run itself is not writable to
	# it and the pidfile never appeared.
	if [ ! -d /var/run/halite ]; then
		install -d -o "${halite_api_user}" -m 0755 /var/run/halite || return 1
	fi
	return 0
}

run_rc_command "$1"
