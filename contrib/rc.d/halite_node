#!/bin/sh

# PROVIDE: halite_node
# REQUIRE: LOGIN FILESYSTEMS
# KEYWORD: shutdown
#
# halite-node, the managed endpoint agent.
#
# Add to /etc/rc.conf to enable:
#
#   halite_node_enable (bool):   Set to "NO" by default.
#   halite_node_config (str):    Configuration file.
#                                Default /usr/local/etc/halite/node.yaml
#   halite_node_flags (str):     Extra arguments to `halite-node connect`.
#   halite_node_user (str):      Account to run as. Default root, because a
#                                node applies state to the whole system; set
#                                it to something else only if you know every
#                                state in your tree can run unprivileged.
#
# `connect` holds the subscribe stream open to the hub, runs the jobs
# that arrive on it, and carries this node's beacons and schedule. It
# reconnects on its own, with backoff, so an unreachable hub is not a
# failure. A node with no hub is driven by `halite-node state apply
# --local` instead — see halite_highstate for running that on a
# schedule.

. /etc/rc.subr

name=halite_node
rcvar=halite_node_enable
desc="halite node agent"

load_rc_config $name

: ${halite_node_enable="NO"}
: ${halite_node_config="/usr/local/etc/halite/node.yaml"}
: ${halite_node_flags=""}
: ${halite_node_user="root"}
# The FIPS deployment of SPEC 27.4. Setting halite_node_fips="YES" in
# rc.conf runs the -fips artifact with FIPS mode stated rather than
# inherited, so a GODEBUG in the environment cannot quietly turn it off.
: ${halite_node_fips="NO"}
if checkyesno halite_node_fips; then
	: ${halite_node_program="/usr/local/bin/halite-node-fips"}
	: ${halite_node_env="GODEBUG=fips140=on"}
else
	: ${halite_node_program="/usr/local/bin/halite-node"}
	: ${halite_node_env=""}
fi

pidfile="/var/run/${name}.pid"
logfile="/var/log/halite/node.log"

command="/usr/sbin/daemon"
command_args="-c -f -p ${pidfile} -o ${logfile} \
	${halite_node_env:+env ${halite_node_env}} ${halite_node_program} connect --config ${halite_node_config} ${halite_node_flags}"

required_files="${halite_node_config}"
start_precmd="halite_node_prestart"

halite_node_prestart()
{
	# Create the log directory if it is missing. An existing one is left
	# exactly as it is: a site that has given it to another account, or
	# pointed it at a separate filesystem, meant to, and refusing to start
	# over that would be this script second-guessing the operator.
	if [ ! -d /var/log/halite ]; then
		install -d -o "${halite_node_user}" -m 0750 /var/log/halite || return 1
	fi
	return 0
}

run_rc_command "$1"
