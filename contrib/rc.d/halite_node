#!/bin/sh

# PROVIDE: halite_node
# REQUIRE: LOGIN FILESYSTEMS
# KEYWORD: shutdown
#
# halite-node, the managed endpoint agent.
#
# Add to /etc/rc.conf to enable:
#
#   halite_node_enable (bool):   Set to "NO" by default.
#   halite_node_config (str):    Configuration file.
#                                Default /usr/local/etc/halite/node.yaml
#   halite_node_flags (str):     Extra arguments to `halite-node serve`.
#   halite_node_user (str):      Account to run as. Default root, because a
#                                node applies state to the whole system; set
#                                it to something else only if you know every
#                                state in your tree can run unprivileged.
#
# `serve` connects to a hub, which arrives in phase 2 of SPEC section 32.
# Until then this script starts a process that exits immediately saying so,
# and a node is driven with `halite-node state apply --local` — see
# halite_highstate for running that on a schedule.

. /etc/rc.subr

name=halite_node
rcvar=halite_node_enable
desc="halite node agent"

load_rc_config $name

: ${halite_node_enable="NO"}
: ${halite_node_config="/usr/local/etc/halite/node.yaml"}
: ${halite_node_flags=""}
: ${halite_node_user="root"}

pidfile="/var/run/${name}.pid"
logfile="/var/log/halite/node.log"

command="/usr/sbin/daemon"
command_args="-c -f -p ${pidfile} -o ${logfile} \
	/usr/local/bin/halite-node serve --config ${halite_node_config} ${halite_node_flags}"

required_files="${halite_node_config}"
start_precmd="halite_node_prestart"

halite_node_prestart()
{
	# Create the log directory if it is missing. An existing one is left
	# exactly as it is: a site that has given it to another account, or
	# pointed it at a separate filesystem, meant to, and refusing to start
	# over that would be this script second-guessing the operator.
	if [ ! -d /var/log/halite ]; then
		install -d -o "${halite_node_user}" -m 0750 /var/log/halite || return 1
	fi
	return 0
}

run_rc_command "$1"
