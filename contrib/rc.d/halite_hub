#!/bin/sh

# PROVIDE: halite_hub
# REQUIRE: LOGIN FILESYSTEMS
# KEYWORD: shutdown
#
# halite-hub, the central service.
#
#   halite_hub_enable (bool):  Set to "NO" by default.
#   halite_hub_config (str):   Configuration file.
#                              Default /usr/local/etc/halite/hub.yaml
#   halite_hub_flags (str):    Extra arguments to `halite-hub serve`.
#   halite_hub_user (str):     Account to run as. Default halite: the hub
#                              serves files and compiles pillar, and needs
#                              no privilege beyond reading its own tree.
#
# `serve` runs the control plane: enrollment, the key lifecycle, and the
# subscribe stream. It creates the enrollment CA under pki_dir on first
# run, so that directory must be writable by halite_hub_user.

. /etc/rc.subr

name=halite_hub
rcvar=halite_hub_enable
desc="halite hub"

load_rc_config $name

: ${halite_hub_enable="NO"}
: ${halite_hub_config="/usr/local/etc/halite/hub.yaml"}
: ${halite_hub_flags=""}
: ${halite_hub_user="halite"}

pidfile="/var/run/${name}.pid"
logfile="/var/log/halite/hub.log"

command="/usr/sbin/daemon"
command_args="-c -f -p ${pidfile} -u ${halite_hub_user} -o ${logfile} \
	/usr/local/bin/halite-hub serve --config ${halite_hub_config} ${halite_hub_flags}"

required_files="${halite_hub_config}"
start_precmd="halite_hub_prestart"

halite_hub_prestart()
{
	# Create the log directory if it is missing. An existing one is left
	# exactly as it is: a site that has given it to another account, or
	# pointed it at a separate filesystem, meant to, and refusing to start
	# over that would be this script second-guessing the operator.
	if [ ! -d /var/log/halite ]; then
		install -d -o "${halite_hub_user}" -m 0750 /var/log/halite || return 1
	fi
	return 0
}

run_rc_command "$1"
