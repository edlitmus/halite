#!/bin/sh

# PROVIDE: halite_hub
# REQUIRE: LOGIN FILESYSTEMS
# KEYWORD: shutdown
#
# halite-hub, the central service.
#
#   halite_hub_enable (bool):  Set to "NO" by default.
#   halite_hub_config (str):   Configuration file.
#                              Default /usr/local/etc/halite/hub.yaml
#   halite_hub_flags (str):    Extra arguments to `halite-hub serve`.
#   halite_hub_user (str):     Account to run as. Default halite: the hub
#                              serves files and compiles pillar, and needs
#                              no privilege beyond reading its own tree.
#
# `serve` runs the control plane: enrollment, the key lifecycle, and the
# subscribe stream. It creates the enrollment CA under pki_dir on first
# run, so that directory must be writable by halite_hub_user.

. /etc/rc.subr

name=halite_hub
rcvar=halite_hub_enable
desc="halite hub"

load_rc_config $name

: ${halite_hub_enable="NO"}
: ${halite_hub_config="/usr/local/etc/halite/hub.yaml"}
: ${halite_hub_flags=""}
: ${halite_hub_user="halite"}
# The FIPS deployment of SPEC 27.4. Setting halite_hub_fips="YES" in
# rc.conf runs the -fips artifact with FIPS mode stated rather than
# inherited, so a GODEBUG in the environment cannot quietly turn it off.
#
# Named _binary and not _program: rc.subr reserves `${name}_program` and
# uses it to replace `command`, so calling it that silently bypassed
# daemon(8) and ran the binary with daemon's own flags as arguments.
: ${halite_hub_fips="NO"}
if checkyesno halite_hub_fips; then
	: ${halite_hub_binary="/usr/local/bin/halite-hub-fips"}
	: ${halite_hub_env="GODEBUG=fips140=on"}
else
	: ${halite_hub_binary="/usr/local/bin/halite-hub"}
	: ${halite_hub_env=""}
fi

pidfile="/var/run/halite/${name}.pid"
# The pid in that file is the program's, not daemon(8)'s: `-p` records the
# child. rc.subr matches the pidfile's process against `procname`, which
# defaults to `command` — so without this it looked for `daemon` at a pid
# belonging to halite-hub , found nothing, and reported the
# service as not running. `stop` and `restart` then did nothing at all.
procname="${halite_hub_binary}"
logfile="/var/log/halite/hub.log"

command="/usr/sbin/daemon"
command_args="-c -f -p ${pidfile} -o ${logfile} \
	${halite_hub_env:+env ${halite_hub_env}} ${halite_hub_binary} serve --config ${halite_hub_config} ${halite_hub_flags}"

required_files="${halite_hub_config}"
start_precmd="halite_hub_prestart"

halite_hub_prestart()
{
	# Create the log directory if it is missing. An existing one is left
	# exactly as it is: a site that has given it to another account, or
	# pointed it at a separate filesystem, meant to, and refusing to start
	# over that would be this script second-guessing the operator.
	if [ ! -d /var/log/halite ]; then
		install -d -o "${halite_hub_user}" -m 0750 /var/log/halite || return 1
	fi
	# And a directory for the pidfile that the account can write. This
	# runs as root; by the time daemon(8) runs, rc.subr has already
	# dropped to halite_hub_user, so /var/run itself is not writable to
	# it and the pidfile never appeared.
	if [ ! -d /var/run/halite ]; then
		install -d -o "${halite_hub_user}" -m 0755 /var/run/halite || return 1
	fi

	# The log file itself, created here as root and owned by the account
	# rather than left to daemon(8). A log directory surviving an earlier
	# install is usually root-owned, and this script deliberately leaves
	# an existing one alone — so daemon, already dropped to
	# halite_hub_user, could not create the file inside it and failed
	# with `open: Permission denied`, naming no file at all.
	#
	# Created only when missing, so a restart never truncates the log,
	# and given to the account either way. Taking ownership of the file
	# this service writes is not the same as reaching into the
	# operator's directory, which is left exactly as it is.
	if [ ! -f "${logfile}" ]; then
		install -o "${halite_hub_user}" -m 0640 /dev/null "${logfile}" || return 1
	else
		chown "${halite_hub_user}" "${logfile}" || return 1
	fi
	return 0
}

run_rc_command "$1"
