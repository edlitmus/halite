#!/bin/sh

# PROVIDE: halite_highstate
# REQUIRE: LOGIN FILESYSTEMS
# KEYWORD: nojail
#
# Apply halite's highstate once, from local roots.
#
# A node compiles and applies its own tree with no hub at all — Salt's
# masterless mode. A node that has a hub is driven by halite_node
# instead, and carries its schedule in its own configuration. Run this
# from cron for a periodic convergence, or by hand after changing the
# tree:
#
#   service halite_highstate onestart
#
# Add to /etc/rc.conf to enable at boot:
#
#   halite_highstate_enable (bool): Set to "NO" by default.
#   halite_highstate_config (str):  Configuration file.
#   halite_highstate_flags (str):   Extra arguments. `--test` makes the run
#                                   predict without changing anything.
#   halite_highstate_fips (bool):   Run the -fips artifact of SPEC 27.4,
#                                   with FIPS mode stated rather than
#                                   inherited. Default "NO".
#
# The exit code follows SPEC section 11.8: 0 when something changed, 2 when
# the node was already converged, and non-zero-and-not-2 when a state
# failed. A cron job that treats 2 as success will not page you for a
# node that had nothing to do.

. /etc/rc.subr

name=halite_highstate
rcvar=halite_highstate_enable
desc="halite highstate, applied once"

load_rc_config $name

: ${halite_highstate_enable="NO"}
: ${halite_highstate_config="/usr/local/etc/halite/node.yaml"}
: ${halite_highstate_flags=""}
: ${halite_highstate_fips="NO"}
if checkyesno halite_highstate_fips; then
	: ${halite_highstate_binary="/usr/local/bin/halite-node-fips"}
	: ${halite_highstate_env="GODEBUG=fips140=on"}
else
	: ${halite_highstate_binary="/usr/local/bin/halite-node"}
	: ${halite_highstate_env=""}
fi

required_files="${halite_highstate_config}"
start_cmd="halite_highstate_start"
stop_cmd=":"

halite_highstate_start()
{
	# Only when it is missing. An existing directory is left exactly as
	# it is: a site that gave it to another account or put it on its own
	# filesystem meant to, and `install -d -m` on an existing one resets
	# the mode underneath them.
	if [ ! -d /var/log/halite ]; then
		install -d -m 0750 /var/log/halite || return 1
	fi
	echo "Applying halite highstate."
	${halite_highstate_env:+env ${halite_highstate_env}} \
		"${halite_highstate_binary}" state apply --local \
		--config "${halite_highstate_config}" ${halite_highstate_flags} \
		>> /var/log/halite/highstate.log 2>&1
	rc=$?
	# 2 is "converged, nothing to do", which is a success at boot.
	if [ $rc -eq 2 ]; then
		echo "halite: already converged."
		return 0
	fi
	if [ $rc -ne 0 ]; then
		warn "halite highstate failed; see /var/log/halite/highstate.log"
	fi
	return $rc
}

run_rc_command "$1"
